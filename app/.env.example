# Copy to .env and fill in from the Supabase project (Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Logins are mobile numbers; behind the scenes each one is stored as <number>@<this domain>
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=login.scorpionchemical.app
